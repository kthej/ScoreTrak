    module Layouts {
        function MainLayout(dc as Graphics.Dc) as Array<WatchUi.Drawable> {
            var rez_cmp_local_var_dc_getHeight = dc.getHeight();

            var rez_cmp_local_var_dc_getWidth = dc.getWidth();

            var rez_cmp_local_text_HomeLabel = new WatchUi.Text({:identifier=>"HomeLabel", :color=>Graphics.COLOR_WHITE, :locX=>(rez_cmp_local_var_dc_getWidth * (25 / 100.0)), :locY=>(rez_cmp_local_var_dc_getHeight * (42 / 100.0)), :text=>"HOME", :justification=>Graphics.TEXT_JUSTIFY_CENTER, :font=>Graphics.FONT_SMALL});

            var rez_cmp_local_text_HomeScore = new WatchUi.Text({:identifier=>"HomeScore", :color=>Graphics.COLOR_WHITE, :locX=>(rez_cmp_local_var_dc_getWidth * (25 / 100.0)), :locY=>(rez_cmp_local_var_dc_getHeight * (70 / 100.0)), :text=>"00", :justification=>Graphics.TEXT_JUSTIFY_CENTER|Graphics.TEXT_JUSTIFY_VCENTER, :font=>Graphics.FONT_NUMBER_HOT});

            var rez_cmp_local_text_GuestLabel = new WatchUi.Text({:identifier=>"GuestLabel", :color=>Graphics.COLOR_WHITE, :locX=>(rez_cmp_local_var_dc_getWidth * (75 / 100.0)), :locY=>(rez_cmp_local_var_dc_getHeight * (42 / 100.0)), :text=>"GUEST", :justification=>Graphics.TEXT_JUSTIFY_CENTER, :font=>Graphics.FONT_SMALL});

            var rez_cmp_local_text_GuestScore = new WatchUi.Text({:identifier=>"GuestScore", :color=>Graphics.COLOR_WHITE, :locX=>(rez_cmp_local_var_dc_getWidth * (75 / 100.0)), :locY=>(rez_cmp_local_var_dc_getHeight * (70 / 100.0)), :text=>"00", :justification=>Graphics.TEXT_JUSTIFY_CENTER|Graphics.TEXT_JUSTIFY_VCENTER, :font=>Graphics.FONT_NUMBER_HOT});

            var rez_cmp_local_text_SportLabel = new WatchUi.Text({:identifier=>"SportLabel", :color=>Graphics.COLOR_WHITE, :locX=>(rez_cmp_local_var_dc_getWidth * (55 / 100.0)), :locY=>(rez_cmp_local_var_dc_getHeight * (15 / 100.0)), :text=>"Sport", :justification=>Graphics.TEXT_JUSTIFY_RIGHT|Graphics.TEXT_JUSTIFY_VCENTER, :font=>Graphics.FONT_XTINY});

            var rez_cmp_local_text_TimeLabel = new WatchUi.Text({:identifier=>"TimeLabel", :color=>Graphics.COLOR_BLACK, :locX=>(rez_cmp_local_var_dc_getWidth * (82 / 100.0)), :locY=>(rez_cmp_local_var_dc_getHeight * (18 / 100.0)), :text=>"10:00", :justification=>Graphics.TEXT_JUSTIFY_CENTER|Graphics.TEXT_JUSTIFY_VCENTER, :font=>Graphics.FONT_XTINY});

            return [rez_cmp_local_text_HomeLabel, rez_cmp_local_text_HomeScore, rez_cmp_local_text_GuestLabel, rez_cmp_local_text_GuestScore, rez_cmp_local_text_SportLabel, rez_cmp_local_text_TimeLabel] as Array<WatchUi.Drawable>;
        }
    } // Layouts

